#!/bin/sh
# Installed launcher: step collection, dispatched on the probed source.
# With a hardware step counter this takes one cumulative sample and
# exits (run by xx-vitals-collect-hw.service on its 15-minute timer).
# Without one it runs the motion-gated resident sampler (run by
# xx-vitals-collect.service, Type=simple) until SIGTERM. The pedometer
# is opt-in and off by default (collect_enabled in config.json): when
# off, or when no accelerometer or step counter is present, this
# writes nothing — gap days render as gaps, never zeroes.
# Run as a module with the datadir on the path: running the file by
# path puts the package directory itself on sys.path, not its parent.
PYTHONPATH="@app_dir@${PYTHONPATH:+:$PYTHONPATH}" exec @python@ -m xx_vitals.collect.service "$@"

# This is a systemd user unit intended to be started with gnome-session.

[Unit]
# xx-keyboard: Stevia fork (same sm.puri.OSK0 name, xx-keyboard binary).
Description=xx-keyboard, a user friendly on screen keyboard
Documentation=https://gitlab.gnome.org/World/Phosh/stevia
CollectMode=inactive-or-failed

After=gnome-session-initialized.target

[Service]
Slice=session.slice
Type=dbus
BusName=@busname@
ExecStart=@bindir@/xx-keyboard --allow-replacement
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>XX-WM</vendor>
  <vendor_url>https://github.com/piercingxx/linux-phone</vendor_url>

  <action id="io.piercingxx.XXWM.Helper1.set-charge-limit">
    <description>Set the battery charge limit</description>
    <message>Authentication is required to set the battery charge limit.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.app-network">
    <description>Block or unblock network access for an app</description>
    <message>Authentication is required to change per-app network access.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.freeze">
    <description>Freeze or thaw an app cgroup</description>
    <message>Authentication is required to freeze or thaw an app.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.clean-system">
    <description>Clean package caches and the system journal</description>
    <message>Authentication is required to clean system caches.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.read-log">
    <description>Read a system log</description>
    <message>Authentication is required to read system logs.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.refresh-packages">
    <description>Refresh the package index</description>
    <message>Authentication is required to refresh the package index.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.upgrade-system">
    <description>Install system updates</description>
    <message>Authentication is required to install system updates.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.remove-package">
    <description>Uninstall a system package</description>
    <message>Authentication is required to uninstall software.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.service-manage">
    <description>Start, stop, restart, enable or disable a system service</description>
    <message>Authentication is required to change a system service.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.service-remote">
    <description>Start or enable the SSH server</description>
    <message>Authentication is required to open remote SSH access.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.rfkill">
    <description>Block or unblock a WiFi or Bluetooth radio</description>
    <message>Authentication is required to change a radio block.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.firewall-open">
    <description>Open an inbound port or disable the firewall</description>
    <message>Authentication is required to open inbound access.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.piercingxx.XXWM.Helper1.firewall-restrict">
    <description>Close an inbound port or enable the firewall</description>
    <message>Authentication is required to restrict inbound access.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>

#!/bin/sh
# A second wrapper must never start a second session: tapping the shell's
# own drawer entry (or any double start) would spawn a second keyboard and
# gesture daemon, and the duplicate python child exits 0 once the running
# instance takes the activation — which this loop reads as session end
# and tears the session down for. Bail out while the live shell still
# serves its IPC socket (a stale socket file with no listener is ignored).
_xx_probe_live() {
    [ -S "$1/xx-wm.sock" ] && @python@ -c \
        'import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(2)
s.connect(sys.argv[1])' "$1/xx-wm.sock" 2>/dev/null
}
# ipc.py serves $XDG_RUNTIME_DIR/xx-wm.sock, falling back to
# ~/.local/share/xx-wm/xx-wm.sock when it is unset: probe both.
if _xx_probe_live "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    || _xx_probe_live "$HOME/.local/share/xx-wm"; then
    echo "xx-wm: already running, not starting a second session" >&2
    exit 0
fi
# Runs inside the phoc session. Start the on-screen keyboard (squeekboard,
# with the PiercingXX Colemak layouts) before the shell; squeekboard shows
# and hides itself on input-method activation, and the shade/lock windows
# sit on higher layers.
if command -v squeekboard >/dev/null 2>&1; then
    squeekboard &
fi

# First-login rename so the binding generator reads the migrated
# gestures.json (ShellConfig also does this; doing it here covers the
# session-start path).
_xxcfg="$HOME/.config/xx-wm"
_legacy="$HOME/.config/piercing-shell"
if [ -d "$_legacy" ] && [ ! -e "$_xxcfg" ]; then
    mv "$_legacy" "$_xxcfg"
fi

# System-level gestures: lisgd reads the touchscreen evdev directly, so edge
# swipes work while any app is focused — each binding feeds the shell IPC.
# Override autodetection with PIERCING_TOUCH_DEV=/dev/input/eventN.
if command -v lisgd >/dev/null 2>&1; then
    _touch_dev=${PIERCING_TOUCH_DEV:-}
    if [ -z "$_touch_dev" ]; then
        # Detect a touchscreen by INPUT_PROP_DIRECT (0x2), not by name — the
        # controller may be called FTSC1000 / Goodix / Elan, never "touch".
        for _sys in /sys/class/input/event*; do
            _props=$(cat "$_sys/device/properties" 2>/dev/null)
            [ -z "$_props" ] && continue
            if [ "$(( 0x$_props & 2 ))" -ne 0 ] 2>/dev/null; then
                _touch_dev="/dev/input/$(basename "$_sys")"
                break
            fi
        done
    fi
    if [ -n "$_touch_dev" ] && [ -r "$_touch_dev" ]; then
        # Bindings are generated from ~/.config/xx-wm/gestures.json by
        # gesture_bindings.py (docs/config.md "gestures.json"): one -g
        # value per line. Action names map through ACTION_TO_VERB;
        # invalid values keep DEFAULT_VERBS. Pinned by
        # tests/test_gesture_bindings.py. The subshell keeps the wrapper's
        # own positional parameters (forwarded to main.py below) intact.
        # Rebinding from Settings restarts lisgd in-process; this
        # session-start path is the fallback.
        (
            set --
            while IFS= read -r _binding; do
                # An empty generator output still yields one empty heredoc
                # line: skip it or lisgd execs with an empty -g binding.
                [ -z "$_binding" ] && continue
                set -- "$@" -g "$_binding"
            done <<EOF
$(@python@ @shell_dir@/gesture_bindings.py --bindir @bindir@)
EOF
            if [ "$#" -gt 0 ]; then
                exec lisgd -d "$_touch_dev" "$@"
            fi
            echo "xx-wm: gesture binding generation failed" >&2
        ) &
    else
        echo "xx-wm: no readable touchscreen for lisgd" >&2
    fi
fi

# gtk4-layer-shell MUST be loaded before libgtk-4, or every layer surface
# (shade, lock screen, switcher, call UI) silently falls back to a normal
# decorated window and the home screen falls back to fullscreen. Python
# imports GTK first, so preload the library. Path differs by distro/arch —
# resolve it via ldconfig, then a multiarch glob.
_ls_lib=$(ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell\.so\.0/ {print $NF; exit}')
if [ -z "$_ls_lib" ]; then
    for _p in /usr/lib/libgtk4-layer-shell.so.0 /usr/lib/*/libgtk4-layer-shell.so.0; do
        [ -e "$_p" ] && _ls_lib="$_p" && break
    done
fi
if [ -n "$_ls_lib" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$_ls_lib"
fi

# systemd user session: the user manager has its own environment, so a
# session started under systemd must import the display there — programs
# it starts (xdg-desktop-portal, D-Bus-activated contacts/xx-share/dialer
# services) otherwise launch without WAYLAND_DISPLAY. OpenRC hosts skip
# all of this (no user manager to feed).
_xx_systemd_user() {
    [ -d "${XX_WM_SYSTEMD_RUN_DIR:-/run/systemd/system}" ] && \
        command -v systemctl >/dev/null 2>&1
}

_xx_session_begin() {
    if ! _xx_systemd_user; then
        return 0
    fi
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd \
            WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DISPLAY \
            2>/dev/null || true
    fi
    # Pulls graphical-session.target in through BindsTo, which
    # xdg-desktop-portal.service needs (Requisite=...).
    systemctl --user start xx-wm-session.target 2>/dev/null || true
}

_xx_session_end() {
    if _xx_systemd_user; then
        systemctl --user stop xx-wm-session.target 2>/dev/null || true
    fi
    # lisgd outlives the shell (rebinds detach it with start_new_session,
    # and the session-start instance is this wrapper's child): kill it or
    # every bezel gesture fires twice on the next login.
    pkill -x -U "$(id -u)" lisgd 2>/dev/null || true
}

# Do not exec python: phoc -E must keep this wrapper as its client.
# Deploy SIGUSR1s the python child only; we respawn it with fresh FDs.
# Gio.Application maps TERM/INT/HUP to g_application_quit(); app.run()
# then returns 0. Do not use those signals for iterate — 0 is session end.
_child=
_xx_wm_cleanup() {
    trap - TERM INT
    if [ -n "$_child" ]; then
        kill "$_child" 2>/dev/null || true
        wait "$_child" 2>/dev/null || true
    fi
    _xx_session_end
    exit 0
}
trap '_xx_wm_cleanup' TERM INT

_xx_session_begin

# Shell stderr goes to a rotated log, not phoc's /dev/tty7: the wrapper's
# python child would otherwise inherit a bare-phone stderr and every
# traceback would vanish. Rotated at each (re)spawn past 1 MB.
_xx_err_log="$HOME/.local/share/xx-wm/stderr.log"
_xx_rotate_err_log() {
    [ -f "$_xx_err_log" ] || return 0
    _size=$(wc -c <"$_xx_err_log" 2>/dev/null | tr -d ' ') || return 0
    case "$_size" in
        ''|*[!0-9]*) return 0 ;;
    esac
    if [ "$_size" -gt 1048576 ]; then
        mv -f "$_xx_err_log" "$_xx_err_log.1" 2>/dev/null || true
    fi
}

_backoff=1
# phoc started this wrapper as its client (`phoc -E .../xx-wm`). When the
# compositor is gone a respawned shell would attach to the next login's
# compositor and race it, so every pass checks the parent is still alive.
_phoc=$PPID
while :; do
    kill -0 "$_phoc" 2>/dev/null || { _xx_session_end; exit 0; }
    _started=$(date +%s)
    mkdir -p "$HOME/.local/share/xx-wm" 2>/dev/null || true
    chmod 700 "$HOME/.local/share/xx-wm" 2>/dev/null || true
    _xx_rotate_err_log
    @python@ @shell_dir@/main.py "$@" 2>>"$_xx_err_log" &
    _child=$!
    wait "$_child"
    _st=$?
    _child=
    # 0 = Gio.Application quit (power-off / in-shell session end / TERM-to-python)
    if [ "$_st" -eq 0 ]; then
        _xx_session_end
        exit 0
    fi
    # 138 = 128+SIGUSR1: deploy asked the child to die — restart immediately.
    # 137 = 128+SIGKILL (including the OOM killer): back off like any
    # other crash instead of tight-looping while the killer is active.
    # Other non-zero: crash. Back off 1, 2, 4 … 30 s so a shell that dies at
    # startup doesn't respawn every second forever; a run that lasted a
    # minute resets the delay.
    # If the wrapper itself was SIGTERM'd, the trap already exited.
    if [ "$_st" -eq 138 ]; then
        _backoff=1
        continue
    fi
    [ $(( $(date +%s) - _started )) -ge 60 ] && _backoff=1
    echo "xx-wm: shell exited with status $_st; restarting in ${_backoff}s" >&2
    sleep "$_backoff"
    _backoff=$(( _backoff * 2 ))
    [ "$_backoff" -gt 30 ] && _backoff=30
done

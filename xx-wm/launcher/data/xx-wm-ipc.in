#!/bin/sh
# Send one command to the running shell's IPC socket (lisgd bindings, hooks).
# Usage: xx-wm-ipc <command>   e.g. xx-wm-ipc gesture.home
# GitHub.com/PiercingXX
# Resolves the socket exactly like ipc.py _socket_path: $XDG_RUNTIME_DIR
# when set (and non-empty), else ~/.local/share/xx-wm. Exits non-zero when
# the shell is not listening so lisgd failures are visible.
# -S -E: only stdlib (os/socket/sys) is used, so site packages are skipped
# to keep per-gesture spawns cheap.
exec @python@ -S -E - "$1" <<'PYEOF'
import os
import socket
import sys

if len(sys.argv) < 2 or not sys.argv[1]:
    sys.stderr.write('usage: xx-wm-ipc <command>\n')
    raise SystemExit(2)
runtime = os.environ.get('XDG_RUNTIME_DIR') or os.path.join(
    os.path.expanduser('~'), '.local', 'share', 'xx-wm')
path = os.path.join(runtime, 'xx-wm.sock')
try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(0.5)
    sock.connect(path)
    sock.send(sys.argv[1].encode('utf-8'))
    sock.close()
except OSError as exc:
    sys.stderr.write('xx-wm-ipc: cannot connect to %s: %s\n' % (path, exc))
    raise SystemExit(1)
PYEOF

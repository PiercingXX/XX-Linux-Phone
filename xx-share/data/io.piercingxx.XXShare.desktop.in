[Desktop Entry]
Type=Application
Name=xx-share
GenericName=Nearby Share
Comment=Nearby file sharing (LocalSend-compatible)
Exec=@bindir@/xx-share --send %F
Icon=io.piercingxx.XXShare
DBusActivatable=false
MimeType=*/*;
Categories=Utility;Network;
StartupNotify=false
Actions=Send;

[Desktop Action Send]
Name=Send with xx-share
Exec=@bindir@/xx-share --send %F

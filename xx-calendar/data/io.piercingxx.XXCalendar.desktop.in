[Desktop Entry]
Type=Application
Name=xx-calendar
GenericName=Calendar
Comment=Text-first calendar: it shows you your day
Exec=@bindir@/xx-calendar
Icon=io.piercingxx.XXCalendar
DBusActivatable=true
MimeType=text/calendar;
Terminal=false
Categories=Office;Calendar;
StartupNotify=true
Actions=NewEvent;Today;

[Desktop Action NewEvent]
Name=New event
Exec=@bindir@/xx-calendar --new-event

[Desktop Action Today]
Name=Today
Exec=@bindir@/xx-calendar --today
